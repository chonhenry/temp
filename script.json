GET portfolio_view_index/_search {
  "size": 0,
  "aggs": {
    "by_portfolio": {
      "terms": {
        "field": "portfolioName",
        "size": 1000
      },
      "aggs": {
        "owner_info": {
          "top_hits": {
            "size": 1,
            "_source": [
              "portfolioOwnerName",
              "portfolioOwnerSid"
            ]
          }
        },
        "unique_sealId_count": {
          "scripted_metric": {
            "init_script": "state.sealIds = new HashSet();",
            "map_script": "if (doc['sealId'].size() > 0) { state.sealIds.add(doc['sealId'].value); }",
            "combine_script": "return state.sealIds;",
            "reduce_script": "Set sealIds = new Hashset(); for (s in states) { sealIds.addAll(s); } return sealIds.size();"
          }
        },
        "unique_datasetId_count": {
          "scripted_metric": {
            "init_script": "state.datasetIds = new HashSet();",
            "map_script": "if (doc['datasetId'].size() > 0) { state.datasetIds.add(doc['datasetId'].value); }",
            "combine_script": "return state.datasetIds;",
            "reduce_script": "Set datasetIds = new Hashset(); for (s in states) { datasetIds.addAll(s); } return datasetIds.size();"
          }
        },
      }
    }
  }
}